// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "llava",
  //"service": "llava",
  "build": {
    "dockerfile": "../../docker_llava/Dockerfile",
    "context": "..",
    "args": {
      "COMPOSE_PROJ_NAME": "llava",
      "KIND": "3.10"
    }
  },
  "workspaceFolder": "/workspace",
  "mounts": [
    "type=bind,source=/storage-01/datasets/ISIC19/,target=/workspace/datasets/ISIC19/",
    "type=bind,source=/storage-01/ml-stud-share/ml-stud21,target=/workspace/home01",
    "type=bind,source=/home/ml-stud21,target=/workspace/home"
  ],
  "remoteUser": "root", // More info: https://aka.ms/dev-containers-non-root
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "tamasfe.even-better-toml",
        "github.copilot",
        "genieai.chatgpt-vscode",
        "ms-toolsai.jupyter",
        "mikestead.dotenv",
        "ms-python.black-formatter"
      ]
    }
  },
  "runArgs": [
    "--gpus",
    "all",
    //"device=1,2",
    "--shm-size",
    "50G"
  ],
  "postCreateCommand": "bash -c /../../docker_llava/entrypoint.sh"
}